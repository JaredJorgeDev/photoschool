# PhotoSchool backend configuration
# Copy these values to Vercel Environment Variables. Do not commit real secrets.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public reference domain. Do not configure DNS here.
PHOTOSCHOOL_PUBLIC_URL=https://photoschool-demo.vercel.app

# Backend admin auth will use a hash in production.
PHOTOSCHOOL_ADMIN_USERNAME=alberto
PHOTOSCHOOL_ADMIN_PASSWORD_HASH=db40d1723c66ccdb9593f4a44cd333db6b1c4e7c5d382fd32518f0cce0fe1adb

# Future Mercado Pago integration. Keep empty until Alberto provides sandbox or production credentials.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_PUBLIC_KEY=

# Optional operational settings.
PHOTOSCHOOL_TIMEZONE=America/Mexico_City
PHOTOSCHOOL_GALLERY_VALIDITY_MONTHS=2
PHOTOSCHOOL_DOWNLOAD_VALIDITY_DAYS=7
